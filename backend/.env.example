# Copiar a .env y ajustar los valores para tu entorno local.
# No commitear nunca el .env real.

# --- Base de datos local ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=turnify
DB_HOST=localhost
DB_PORT=5432

# Alternativa a las variables DB_*: cadena de conexion completa.
# Si esta definida, tiene prioridad sobre las anteriores.
# DATABASE_URL=postgresql://usuario:password@localhost:5432/turnify

# --- Servidor ---
PORT=3000
# En desarrollo se usa un valor por defecto; en produccion es obligatorio.
SESSION_SECRET=cambiar-por-un-valor-aleatorio-largo

# --- Datos demo (opcional) ---
# Contrasena de los usuarios creados por npm run db:setup.
# DEMO_PASSWORD=Turnify2026!
